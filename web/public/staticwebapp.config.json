{
  "routes": [
    {
      "route": "/data/*.{json}",
      "headers": { "cache-control": "public, max-age=0, must-revalidate" }
    },
    {
      "route": "/audio/*.{json}",
      "headers": { "cache-control": "public, max-age=0, must-revalidate" }
    },
    {
      "route": "/scenes/*.{json}",
      "headers": { "cache-control": "public, max-age=0, must-revalidate" }
    },
    {
      "route": "/assets/*",
      "headers": { "cache-control": "public, max-age=86400" }
    },
    {
      "route": "/data/*",
      "headers": { "cache-control": "public, max-age=86400" }
    },
    {
      "route": "/audio/*",
      "headers": { "cache-control": "public, max-age=86400" }
    },
    {
      "route": "/scenes/*",
      "headers": { "cache-control": "public, max-age=86400" }
    }
  ],
  "mimeTypes": {
    ".ogg": "audio/ogg",
    ".gz": "application/octet-stream",
    ".bin": "application/octet-stream"
  }
}
